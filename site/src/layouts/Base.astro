---
import '@fontsource/bebas-neue';
import '@fontsource/chakra-petch/400.css';
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/600.css';
import '@fontsource/chakra-petch/700.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import { withBase } from '../lib/urls';
import { getChapters } from '../lib/chapters';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageSize?: [number, number];
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object | object[];
  prev?: number | null;
  next?: number | null;
}
const latest = (await getChapters()).at(-1)!;
// Image de partage par défaut : la vignette du dernier chapitre (400 × 560).
const {
  title, description, image = withBase(`/thumbs/${latest.n}.webp`), imageAlt = `Player, chapitre ${latest.n}`,
  imageSize = [400, 560], type = 'website', noindex = false, jsonLd = [], prev = null, next = null,
} = Astro.props;
---
<!doctype html>
<html lang={SITE.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#121212" />
  <!-- Validation Google Search Console (propriété https://player-fr.vercel.app/). -->
  <meta name="google-site-verification" content="SNxTmCaCU1LQU27Y49WFk_PdyrK6E-0qViYOI0jQmzo" />
  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  <link rel="manifest" href={withBase('/manifest.webmanifest')} />
  <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
  <Seo {title} {description} {image} {imageAlt} {imageSize} {type} {noindex} jsonLd={[jsonLd].flat()} {prev} {next} />
  <script is:inline>
    // Mode d’affichage et aperçus posés avant le premier rendu (pas de saut EN|FR -> FR, pas d’aperçu
    // qui divulgâche le temps d’un éclair), et après chaque navigation.
    (() => {
      const apply = () => {
        let v = null, t = null;
        try { v = localStorage.getItem('view'); t = localStorage.getItem('thumbs'); } catch { /* stockage bloqué : valeurs par défaut */ }
        document.documentElement.dataset.view = ['en', 'both', 'fr'].includes(v) ? v : 'both';
        document.documentElement.dataset.thumbs = t === 'show' ? 'show' : 'hide';
      };
      apply();
      if (!window.__playerView) {
        window.__playerView = true;
        document.addEventListener('astro:after-swap', apply);
      }
    })();
  </script>
  <ClientRouter />
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <Header {prev} {next} />
  <main id="contenu" tabindex="-1">
    <slot />
  </main>
  <!-- Hors de <main> : son z-index ferait passer les éléments fixes du lecteur sous la barre. -->
  <slot name="overlay" />
  <Footer />
</body>
</html>
