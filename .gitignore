# Planches originales (1,4 Go) : hors du dépôt. Leurs copies allégées (WebP q80, ~600 Mo) sont
# versionnées dans chapters_web/ (python scripts/compress_pages.py) et publiées sur GitHub Pages.
chapters_en/
chapters_fr/

# Anime Ace 2 (Blambot) : licence sans redistribution. À installer soi-même dans fonts/.
fonts/AnimeAce2-*
fonts/LICENSE-AnimeAce2-Blambot.txt

# Dossier de travail régénérable : on garde seulement les inventaire.json (évitent de refaire l'OCR).
inventaire/**/*.png
inventaire/**/*.log
inventaire/*.json

# Modèles ONNX (201 Mo), téléchargeables : voir README.
models/*.onnx

__pycache__/
.pytest_cache/

# Site Astro
site/node_modules/
site/dist/
site/.astro/
site/test-results/
site/playwright-report/

# Journaux d’outils
.playwright-mcp/
.playwright-cli/

# Travail de design (captures avant / après, maquettes OpenPencil, rapports de design-taste-frontend)
design/
.taste-skill/
.claude/settings.local.json
